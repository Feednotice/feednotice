# FeedNotice settings. Copy to .env next to compose.yaml, fill in the blanks, then: chmod 600 .env
# Docker Compose reads this file for both containers (app, mta) and for its own variables.
# The example names use example.org: replace them with yours (docs/deploy.md).

# Released images to run (CHANGELOG.md); empty = latest.
FEEDNOTICE_VERSION=0.2.0

# --- Public site -------------------------------------------------------------------------
SITE_DOMAIN=example.org
BASE_URL=https://example.org
# Your service's name, shown on every page and email (required). Not "FeedNotice": see TRADEMARKS.md.
SERVICE_NAME=
DEFAULT_LOCALE=en

# --- Secrets (generate each with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=') ----
# SECRET signs every link in every email: never change it once in production, or all
# unsubscribe links already sent stop working.
SECRET=
# Shared between the mta container and the app for bounces (/hooks/bounce).
WEBHOOK_SECRET=

# --- Operator (shown on the privacy page and in emails) ----------------------------------
OPERATOR_NAME=Example Ltd
CONTACT_EMAIL=contact@example.org
PROCESSORS=Example Hosting (server hosting and email sending, EU)

# --- Legal notice (/legal) ---------------------------------------------------------------
# Required for a site published from France (LCEN art. 6-III); Germany has a similar rule
# (Impressum). Empty fields are left out of the page.
LEGAL_COMPANY=
LEGAL_CAPITAL_EUR=
LEGAL_ADDRESS=
LEGAL_REGISTRATION=
LEGAL_SIRET=
LEGAL_VAT=
LEGAL_DIRECTOR=
HOST_NAME=
HOST_ADDRESS=
HOST_PHONE=
# The AGPL requires offering the source code to the people who use the service online.
# Leave empty for an unmodified copy (points to the upstream repository); if you change the
# code, point to your own public copy.
SOURCE_URL=

# --- Branding (docs/branding.md) --------------------------------------------------------
# Folder with your logo, favicons and colours, relative to compose.yaml. Unset = neutral.
# BRAND_PATH=../brand

# --- Email --------------------------------------------------------------------------------
# One stable sending domain, whatever the number of sending servers.
MAIL_FROM=updates@mail.example.org
# Envelope sender: bounces come back here, to the mta container, which hands them to the app.
BOUNCE_ADDRESS=feedback@mail.example.org
# Human replies go to your usual mailbox, not to the sending server.
REPLY_TO=contact@example.org
# postmaster@ and abuse@ of the sending domain are forwarded here.
POSTMASTER_FORWARD=contact@example.org
# Name of this sending server: its PTR (reverse DNS), HELO and A record.
MTA_HOSTNAME=s1.example.org

# DKIM, signed by the app. Create the key with:
#   docker compose run --rm app node src/cli.ts dkim-keygen
# and publish the TXT record it prints.
DKIM_SELECTOR=fn1
DKIM_KEY_FILE=/app/data/dkim/fn1.pem

# Warm-up caps for a new IP (0 = no cap). Raise MAIL_MAX_PER_DAY step by step, see docs/deploy.md.
MAIL_MAX_PER_DAY=200
MAIL_MAX_PER_HOUR=0
# Confirmation emails per hour, all visitors together: a ceiling on abuse.
CONFIRM_MAX_PER_HOUR=300

# --- Operator -----------------------------------------------------------------------------
# Daily report and alerts (bounces, complaints, failures). Empty = none (alerts still logged).
OPS_EMAIL=
OPS_REPORT_HOUR=8

# --- Backups (docs/deploy.md, Backups) ---------------------------------------------------
# Nightly local copy of the database at BACKUP_HOUR, the last BACKUP_KEEP kept (0 = none).
BACKUP_HOUR=3
BACKUP_KEEP=14
# Off-site, encrypted (restic): uncomment to start the backup container.
# COMPOSE_PROFILES=backup
# RESTIC_REPOSITORY=s3:https://s3.example-provider.eu/my-bucket/feednotice
# RESTIC_PASSWORD=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Mail log retention, in days (it holds recipient addresses).
MTA_LOG_DAYS=14

# --- Service ------------------------------------------------------------------------------
POLL_INTERVAL_MINUTES=30
PENDING_TTL_DAYS=7
SUSPENDED_TTL_DAYS=90
DIGEST_HOUR=7
DIGEST_WEEKDAY=1
TIME_ZONE=Europe/Paris
BURST_LIMIT=5
